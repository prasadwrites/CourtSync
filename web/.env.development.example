# Local development against the emulators. Copy to .env.development.local.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-courtsync.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-courtsync
VITE_FIREBASE_STORAGE_BUCKET=demo-courtsync.appspot.com
VITE_FIREBASE_APP_ID=demo-app
VITE_FUNCTIONS_REGION=us-central1
VITE_USE_EMULATORS=true
