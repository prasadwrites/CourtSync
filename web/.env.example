# Firebase web config: Firebase console > Project settings > Your apps > Web app.
# Copy to .env.local (dev), .env.staging or .env.production. These values are public by design;
# security comes from Firestore rules, App Check and Cloud Functions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=courtsync-babfe.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=courtsync-babfe
VITE_FIREBASE_STORAGE_BUCKET=courtsync-babfe.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Functions region (must match FUNCTION_REGION in functions/.env).
VITE_FUNCTIONS_REGION=us-central1

# Set to "true" to use the local emulators (npm run emulators).
VITE_USE_EMULATORS=false

# App Check with reCAPTCHA Enterprise. Leave empty to skip in development.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Web push (Firebase Cloud Messaging > Web Push certificates > Key pair).
VITE_FCM_VAPID_KEY=

# Optional: Google Maps JavaScript API key for facility maps.
VITE_GOOGLE_MAPS_API_KEY=
