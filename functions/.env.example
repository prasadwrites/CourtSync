# Cloud Functions runtime parameters (not secret).
# Copy to functions/.env.<projectId or alias> (e.g. functions/.env.courtsync-babfe), which the
# Firebase CLI loads on deploy. Never put API secrets here: see "Secrets" below.

# Public URL of the web app, used in emails, invite links and payment return URLs.
APP_URL=https://courtsync-babfe.web.app

# Sender address for transactional email (SendGrid verified sender).
EMAIL_FROM=CourtSync <no-reply@example.com>

# Twilio sender number for SMS, E.164 format. Leave empty to disable SMS.
TWILIO_FROM_NUMBER=

# Public keys for payment providers. Leave empty to keep that provider disabled.
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=

# Reject callable requests without a valid App Check token (recommended in staging and prod).
ENFORCE_APP_CHECK=false

# Region for all functions. If you change it, also change the region of the
# /api/webhooks/** rewrite in firebase.json and VITE_FUNCTIONS_REGION in web/.env.*.
FUNCTION_REGION=us-central1

# Allow the sandbox payment provider outside the emulator (dev only, never prod).
# The Super Admin must also enable the "sandboxPayments" feature flag.
ALLOW_SANDBOX_PAYMENTS=false

# ---------------------------------------------------------------------------
# Secrets: stored in Google Secret Manager, read at runtime by functions/src/lib/secrets.ts.
# Create each one with:  firebase functions:secrets:set NAME --project <alias>
# (or: gcloud secrets create NAME --data-file=- --project <projectId>)
# and grant the functions runtime service account roles/secretmanager.secretAccessor.
# A missing secret disables the feature that needs it; deploys don't fail.
#
#   ID_ENCRYPTION_KEY        32 random bytes, base64 (openssl rand -base64 32). Required for ID verification.
#   SENDGRID_API_KEY         Email delivery.
#   TWILIO_ACCOUNT_SID       SMS delivery.
#   TWILIO_AUTH_TOKEN        SMS delivery.
#   STRIPE_SECRET_KEY        Stripe payments and refunds.
#   STRIPE_WEBHOOK_SECRET    Verifies Stripe webhook signatures.
#   RAZORPAY_KEY_SECRET      Razorpay orders and refunds.
#   RAZORPAY_WEBHOOK_SECRET  Verifies Razorpay webhook signatures.
#
# For the emulators you may instead put test values in functions/.secret.local (gitignored).
